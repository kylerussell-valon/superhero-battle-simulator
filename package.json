{
  "name": "superhero-battle-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5177 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5178 --strictPort",
    "typecheck": "tsc --noEmit",
    "assets": "blender --background --python tools/blender/build_assets.py",
    "shot": "node scripts/shot.mjs",
    "gallery": "node scripts/gallery.mjs",
    "contact": "node scripts/contact.mjs",
    "monitor": "node scripts/monitor.mjs",
    "look": "node scripts/look.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
